ent-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[118,466][1356,703]" /><node index="2" text="• " resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,731][118,810]" /><node index="3" text="The 5 Letters: There are five Qalqalah letters: Qāf (ق), Ṭā (ط), Bā (ب), Jīm (ج), and Dāl (د). They can be remembered using the phrase Qutb Jad (قُطْبُ جَدٍّ)." resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[118,731][1356,1065]" /><node index="4" text="• " resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1093][118,1172]" /><node index="5" text="Letters with Shaddah: If a Qalqalah letter carries a Shaddah (ّ) when stopping, hold the stress of the Shaddah first, followed by a strong bouncing echo (e.g., TABB / تَبَّ, BIL-HAQQ / بِالْحَقِّ)." resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[118,1093][1356,1506]" /><node index="6" text="• " resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1534][118,1613]" /><node index="7" text="Rule Boundary: Apply this bouncing sound only to these five specific letters and never to any other letters in the Qur'an." resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[118,1534][1356,1771]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2795][1356,2872]"><node index="0" text="Continue" resource-id="" class="android.widget.TextView" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[606,2847][835,2872]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="prayertime.compassdirection.qiblafinder.hijricalender" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2795][1356,2872]" /></node><node index="3" text="" resource-id="" class="and